{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Influencer Hunter",
  "version": "0.1.0",
  "identifier": "ru.influencerhunter.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Influencer Hunter",
        "width": 1420,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Локальный поиск и база инфлюенсеров",
    "longDescription": "Десктопное приложение для поиска инфлюенсеров, ведения локальной базы блогеров и рекламодателей.",
    "publisher": "Influencer Hunter",
    "category": "Business",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["Russian"],
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Influencer Hunter"
      }
    }
  }
}
